# Pinned images and the KG release to serve (contracts section 10).
# Plain KEY=VALUE (no shell expansion): read by bin/visionkb, by docker compose (--env-file) and by
# bin/visionkb-k8s sync-versions (which writes k8s/base/kustomization.yaml images + release.env).
# Image refs are name:tag@digest; apptainer pulls by digest, docker/k8s ignore the tag when a digest is set.
# Digests: Docker Hub manifest-list digests, checked 2026-11-09.
VISIONKB_NEO4J_IMAGE=neo4j:2026.10.1-community@sha256:7dbd307cc8f35d6a061cf71659d3d8f783c3db9e8c2f5bb9d54f77921931952a
VISIONKB_POSTGRES_IMAGE=postgres:17.11@sha256:ff87138949ad9a46f32ff23bd6852b52ce024a13dffe9b4087be98292cdd3b4f
# visionkb-api is built by GitHub Actions on tag; digest from its v0.1.0 release notes (= GHCR index digest).
VISIONKB_API_IMAGE=ghcr.io/lijinbio/visionkb-api:0.1.0@sha256:87d2ef8a1023433792ccfe08da3db3d85484bd9253fe6cd07b8624c5e28e7dab
# Stdlib-only helper image for bundle download/verification Jobs on Kubernetes.
VISIONKB_TOOLS_IMAGE=python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
# KG release to load/serve by default.
VISIONKB_KG_RELEASE=visionkb-2026.11.0
