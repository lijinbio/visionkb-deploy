# Pinned images and the KG release to serve (contracts section 10).
# Plain KEY=VALUE (no shell expansion): read by bin/visionkb, by docker compose (--env-file) and by
# bin/visionkb-k8s sync-versions (which writes k8s/base/kustomization.yaml images + release.env).
# Image refs are name:tag@digest; apptainer pulls by digest, docker/k8s ignore the tag when a digest is set.
# Digests: Docker Hub manifest-list digests, checked 2026-11-09.
VISIONKB_NEO4J_IMAGE=neo4j:2026.10.1-community@sha256:7dbd307cc8f35d6a061cf71659d3d8f783c3db9e8c2f5bb9d54f77921931952a
VISIONKB_POSTGRES_IMAGE=postgres:17.11@sha256:ff87138949ad9a46f32ff23bd6852b52ce024a13dffe9b4087be98292cdd3b4f
# visionkb-api is built by GitHub Actions on tag; digest from its v0.1.4 release notes (= GHCR index digest).
VISIONKB_API_IMAGE=ghcr.io/lijinbio/visionkb-api:0.1.4@sha256:316e7854ec8540a00bfe4ed33b5780238ff22e71f2fab5a1520bfac2a6f78347
# visionkb-kg MCP server (aiscientist-mcp tag visionkb-kg-v0.0.1): stdio tool for the AiScientist gateway.
# Pulled by `visionkb pull mcp`; not a deployment service (see docs/aiscientist.md).
VISIONKB_MCP_IMAGE=ghcr.io/lijinbio/mcp-visionkb-kg:0.0.1@sha256:2425d3138146d48236dde432aa1094d6a824c0529da82359355b886777d549d4
# AiScientist skills registry release (lijinbio/aiscientist-skills) the gateway installs; see docs/aiscientist.md.
VISIONKB_SKILLS_RELEASE=v0.2.1
# visionkb-web (home page, KG proxy, chat with the user's own Claude key): service `web`, opt-in in
# VISIONKB_SERVICES. Digest from the visionkb-web v0.0.2 release (GHCR, anonymous pull).
VISIONKB_WEB_IMAGE=ghcr.io/lijinbio/visionkb-web:0.0.2@sha256:136a04b545074ae94d9bdfa07ed18022ab09c58af2176dae33c07f749497be60
# Stdlib-only helper image for bundle download/verification Jobs on Kubernetes.
VISIONKB_TOOLS_IMAGE=python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
# KG release to load/serve by default, and the sha256 of its bundle <release>.tar (outer checksum).
# The sha pins only this release: load-release --bundle / unpack-bundle / upload-bundle / fetch-bundle refuse a
# visionkb-2026.11.0 bundle with another sha256; bundles of other releases are not affected. Empty: no pin.
VISIONKB_KG_RELEASE=visionkb-2026.11.0
VISIONKB_KG_BUNDLE_SHA256=0af5a709e65aee1d04637c022f51364537b04a9f2c2fb65c489d273564bef66d
