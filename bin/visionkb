#!/usr/bin/env bash
# visionkb: run a VisionKB KG release (Neo4j Community + PostgreSQL + visionkb-api) as apptainer
# instances on an HPC node, as a non-root user. Dev/test path; production is the Eye server k8s
# (see docs/k8s.md). `visionkb help` lists the commands.
set -euo pipefail

VISIONKB_DEPLOY_VERSION="0.1.6"
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BUNDLE_PY="$REPO_DIR/src/visionkb_deploy/bundle.py"
ALL_SERVICES="postgres neo4j api web"
DEFAULT_SERVICES="postgres neo4j api" # web is opt-in: VISIONKB_SERVICES="postgres neo4j api web"

usage() {
  cat <<'EOF'
Usage: visionkb [--env-file FILE] [--instance NAME] COMMAND [ARGS]

Images and setup
  pull [--force] [SERVICE...]     apptainer pull the pinned images (versions.env) into the images dir;
                                  `pull mcp` pulls the visionkb-kg MCP server image (a stdio tool for the
                                  AiScientist gateway; never started by visionkb, see docs/aiscientist.md)
  init                            create instance dirs and secrets (neo4j password, PG DSN, API tokens, web cookie
                                  secret + access code; mode 600); on an existing instance only missing ones
  config                          print the effective configuration (no secrets)

Releases
  verify-release ID|DIR           check RELEASE, manifest.json and every file checksum
  export-bundle ID [--out DIR]    write/verify <ID>.tar + .sha256 for the Eye server and print copy steps
  unpack-bundle TAR [--dest DIR]  verify the outer sha256 (and VISIONKB_KG_BUNDLE_SHA256 for the pinned
                                  release), unpack, verify the manifest
  load-release [ID] [--from DIR | --bundle TAR] [--force] [--no-activate] [--no-restart] [--expected-ids DIR]
                                  import into a NEW node-local Neo4j store, apply post_import.cypher, check every
                                  node id and relationship key against the CSVs, make it current
  ensure-loaded [--with-previous] re-import the current (and previous) release on this node if its store is
                                  missing (node-local stores vanish with the allocation; the sbatch script runs it)
  rollback [ID]                   serve the previous (or the given) loaded release (re-imports it if needed)
  releases                        list load records, store presence on this node, current/previous pointers

Services (SERVICE: postgres neo4j api web; default: VISIONKB_SERVICES = postgres neo4j api, web is opt-in)
  start|stop|restart [SERVICE...] apptainer instances, bound to 127.0.0.1 by default; start order postgres neo4j
                                  api web, stop in reverse
  status                          instances, ports, releases
  health                          GET /v1/health + /v1/ready, Cypher ping, SQL ping, web /healthz + /readyz;
                                  exit 1 if anything is down
  tunnel-hint [NODE]              print the SSH tunnel command for the enabled services' ports (sbatch prints it)
  logs SERVICE                    print log file locations
  cypher QUERY                    run one read query in the neo4j instance (password read inside the container)
  backup                          pg_dump of the proposals database + release pointers
  restore DIR --yes               pg_restore a backup made by `backup`

Options
  --env-file FILE   settings file (default: $VISIONKB_ENV_FILE, else $VISIONKB_DATA_ROOT/config/visionkb.env if present)
  --instance NAME   instance name (default: $VISIONKB_INSTANCE or "default")
  -h, --help        this help;  --version  print the version
Settings precedence: environment > env file > versions.env > built-in defaults.
EOF
}

die() {
  echo "visionkb: error: $*" >&2
  exit 1
}
log() { echo "visionkb: $*" >&2; }

# shellcheck source=libexec/visionkb-env.sh
source "$REPO_DIR/libexec/visionkb-env.sh"

# ---------------------------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------------------------

set_default() {
  local key="$1" val="$2"
  if [[ -z "${!key:-}" ]]; then
    export "$key=$val"
  fi
}

load_settings() {
  local env_file="${OPT_ENV_FILE:-${VISIONKB_ENV_FILE:-}}"
  if [[ -z "$env_file" && -n "${VISIONKB_DATA_ROOT:-}" && -r "${VISIONKB_DATA_ROOT}/config/visionkb.env" ]]; then
    env_file="${VISIONKB_DATA_ROOT}/config/visionkb.env"
  fi
  if [[ -n "$env_file" ]]; then
    load_env_file "$env_file"
    export VISIONKB_ENV_FILE="$env_file"
  fi
  load_versions_env "$REPO_DIR/versions.env"
  [[ -n "${OPT_INSTANCE:-}" ]] && export VISIONKB_INSTANCE="$OPT_INSTANCE"
  set_default VISIONKB_INSTANCE default
  set_default VISIONKB_SERVICES "$DEFAULT_SERVICES"
  set_default VISIONKB_BIND_ADDRESS 127.0.0.1
  set_default VISIONKB_NEO4J_BOLT_PORT 7687
  set_default VISIONKB_NEO4J_HTTP_PORT 7474
  set_default VISIONKB_NEO4J_LOAD_BOLT_PORT 17687
  set_default VISIONKB_NEO4J_HEAP 2g
  set_default VISIONKB_NEO4J_PAGECACHE 2g
  set_default VISIONKB_NEO4J_READ_ONLY true
  set_default VISIONKB_LOAD_HEAP 4g
  set_default VISIONKB_LOAD_PAGECACHE 2g
  set_default VISIONKB_PG_PORT 5432
  set_default VISIONKB_PG_HOST 127.0.0.1
  set_default VISIONKB_API_HOST 127.0.0.1
  set_default VISIONKB_API_PORT 8770
  set_default VISIONKB_MAX_ROWS 200
  set_default VISIONKB_WEB_HOST 127.0.0.1
  set_default VISIONKB_WEB_PORT 8780
  set_default VISIONKB_WEB_PUBLIC 0
  set_default VISIONKB_WEB_START_TIMEOUT 300 # the app imports take 60-70 s from a SIF on a network filesystem
  set_default VISIONKB_VERIFY_CHECKSUMS 0
  set_default VISIONKB_START_TIMEOUT 300
  set_default VISIONKB_STOP_TIMEOUT 60
  set_default VISIONKB_PYTHON python3

  [[ "$VISIONKB_INSTANCE" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "invalid instance name: $VISIONKB_INSTANCE"
  case "$VISIONKB_INSTANCE" in images | fixtures | tools | apptainer-cache | bundles)
    die "instance name '$VISIONKB_INSTANCE' is reserved"
    ;;
  esac
  local s
  for s in $VISIONKB_SERVICES; do
    case "$s" in postgres | neo4j | api | web) ;; *) die "VISIONKB_SERVICES: unknown service '$s'" ;; esac
  done
  [[ "$VISIONKB_WEB_PUBLIC" == 0 || "$VISIONKB_WEB_PUBLIC" == 1 ]] || die "VISIONKB_WEB_PUBLIC must be 0 or 1"
  for s in VISIONKB_NEO4J_BOLT_PORT VISIONKB_NEO4J_HTTP_PORT VISIONKB_NEO4J_LOAD_BOLT_PORT VISIONKB_PG_PORT \
    VISIONKB_API_PORT VISIONKB_START_TIMEOUT VISIONKB_STOP_TIMEOUT VISIONKB_MAX_ROWS VISIONKB_WEB_PORT \
    VISIONKB_WEB_START_TIMEOUT; do
    [[ "${!s}" =~ ^[0-9]+$ ]] || die "$s must be a number (got '${!s}')"
  done
}

# Paths that need VISIONKB_WORK_DIR (deploy dir) or VISIONKB_DATA_ROOT; resolved lazily.
resolve_paths() {
  if [[ -z "${VISIONKB_DEPLOY_DIR:-}" ]]; then
    [[ -n "${VISIONKB_WORK_DIR:-}" ]] || die "set VISIONKB_WORK_DIR (or VISIONKB_DEPLOY_DIR) in the env file"
    export VISIONKB_DEPLOY_DIR="$VISIONKB_WORK_DIR/visionkb-deploy"
  fi
  set_default VISIONKB_IMAGES_DIR "$VISIONKB_DEPLOY_DIR/images"
  INST="$VISIONKB_DEPLOY_DIR/$VISIONKB_INSTANCE"
  # Neo4j stores, their run dir and the load scratch live on node-local disk: stores written on a network
  # filesystem (BeeGFS) were found corrupted. Load records, logs, pointers, secrets, PostgreSQL stay persistent.
  [[ -n "${VISIONKB_STORE_DIR:-}" ]] || VISIONKB_STORE_DIR="$(default_store_dir)"
  export VISIONKB_STORE_DIR
  STORE="$VISIONKB_STORE_DIR"
  RECORDS="$INST/neo4j/loaded"
  SECRETS="$INST/secrets"
  STATE="$INST/state"
  RUNDIR="$INST/run"
  if [[ -n "${VISIONKB_DATA_ROOT:-}" ]]; then
    set_default VISIONKB_RELEASES_DIR "$VISIONKB_DATA_ROOT/kg/releases"
    set_default VISIONKB_BUNDLES_DIR "$VISIONKB_DATA_ROOT/kg/bundles"
    set_default VISIONKB_BACKUP_DIR "$VISIONKB_DATA_ROOT/backups/visionkb-deploy/$VISIONKB_INSTANCE"
  fi
}

# Filesystem type of PATH (or of its nearest existing parent), as `stat -f` reports it.
fs_type() {
  local p="$1"
  while [[ ! -e "$p" && "$p" != / ]]; do p="$(dirname "$p")"; done
  stat -f -c %T "$p" 2>/dev/null || echo unknown
}
fs_is_network() {
  case "$(fs_type "$1")" in
  nfs* | fhgfs | beegfs | lustre | gpfs | cifs | smb* | ceph* | fuse.ceph* | glusterfs | fuse.glusterfs | fuse.sshfs | afs | panfs | wekafs) return 0 ;;
  *) return 1 ;;
  esac
}
# $TMPDIR/visionkb/<instance> when TMPDIR is an absolute path on local disk, else /tmp/$USER/visionkb/<instance>
default_store_dir() {
  local t="${TMPDIR:-}"
  if [[ "$t" == /* ]] && ! fs_is_network "$t"; then
    printf '%s/visionkb/%s' "${t%/}" "$VISIONKB_INSTANCE"
  else
    printf '/tmp/%s/visionkb/%s' "$(id -un)" "$VISIONKB_INSTANCE"
  fi
}
# Refuse a Neo4j store on a network filesystem unless VISIONKB_ALLOW_NETWORK_STORE=1 (then warn loudly).
check_store_fs() {
  local t
  fs_is_network "$1" || return 0
  t="$(fs_type "$1")"
  if [[ "${VISIONKB_ALLOW_NETWORK_STORE:-0}" == 1 ]]; then
    log "WARNING: ************************************************************************************"
    log "WARNING: Neo4j store $1 is on a network filesystem ($t). Stores written on BeeGFS were found"
    log "WARNING: CORRUPTED (missing nodes, garbled ids). Continuing only because VISIONKB_ALLOW_NETWORK_STORE=1."
    log "WARNING: ************************************************************************************"
  else
    die "Neo4j store dir $1 is on a network filesystem ($t); stores written there were found corrupted. Use node-local disk (VISIONKB_STORE_DIR; default \$TMPDIR/visionkb/<instance> or /tmp/\$USER/visionkb/<instance>) or set VISIONKB_ALLOW_NETWORK_STORE=1 to override."
  fi
}

need_releases_dir() { [[ -n "${VISIONKB_RELEASES_DIR:-}" ]] || die "set VISIONKB_DATA_ROOT or VISIONKB_RELEASES_DIR"; }

ensure_apptainer() {
  command -v apptainer >/dev/null 2>&1 && return 0
  if [[ -n "${VISIONKB_APPTAINER_MODULE:-}" ]]; then
    if ! command -v module >/dev/null 2>&1; then
      local init
      for init in "${VISIONKB_MODULES_INIT:-}" /usr/share/Modules/init/bash /etc/profile.d/modules.sh; do
        if [[ -n "$init" && -r "$init" ]]; then
          set +u
          # shellcheck disable=SC1090
          source "$init"
          set -u
          break
        fi
      done
    fi
    set +u
    module load "$VISIONKB_APPTAINER_MODULE" >/dev/null 2>&1 || true
    set -u
  fi
  command -v apptainer >/dev/null 2>&1 || die "apptainer not found (load it, or set VISIONKB_APPTAINER_MODULE)"
}

python_bundle() { "$VISIONKB_PYTHON" "$BUNDLE_PY" "$@"; }

# --pin argument for bundle.py: the bundle of VISIONKB_KG_RELEASE must have VISIONKB_KG_BUNDLE_SHA256
# (empty sha: no pin; bundles of other releases are not affected).
pin_arg() { printf -- '--pin=%s=%s' "${VISIONKB_KG_RELEASE:-}" "${VISIONKB_KG_BUNDLE_SHA256:-}"; }

# ---------------------------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------------------------

image_ref() {
  case "$1" in
  neo4j) printf '%s' "${VISIONKB_NEO4J_IMAGE:?VISIONKB_NEO4J_IMAGE not set}" ;;
  postgres) printf '%s' "${VISIONKB_POSTGRES_IMAGE:?VISIONKB_POSTGRES_IMAGE not set}" ;;
  api) printf '%s' "${VISIONKB_API_IMAGE:?VISIONKB_API_IMAGE not set}" ;;
  web) printf '%s' "${VISIONKB_WEB_IMAGE:?VISIONKB_WEB_IMAGE not set}" ;;
  mcp) printf '%s' "${VISIONKB_MCP_IMAGE:?VISIONKB_MCP_IMAGE not set}" ;; # pull only; not a service
  *) die "unknown service $1" ;;
  esac
}

# name:tag@sha256:x -> docker://name@sha256:x (digest wins; containers/image rejects tag+digest)
pull_source() {
  local name tag digest
  read -r name tag digest <<<"$(image_parts "$1")"
  if [[ "$digest" != - ]]; then
    printf 'docker://%s@%s' "$name" "$digest"
  else
    printf 'docker://%s:%s' "$name" "${tag/#-/latest}"
  fi
}

# neo4j:2026.10.1-community@sha256:7dbd... -> neo4j_2026.10.1-community_7dbd307cc8f3.sif
sif_name() {
  local name tag digest short=""
  read -r name tag digest <<<"$(image_parts "$1")"
  [[ "$tag" == - ]] && tag=latest
  [[ "$digest" != - ]] && short="_${digest#sha256:}" && short="${short:0:13}"
  printf '%s_%s%s.sif' "${name##*/}" "$tag" "$short"
}

sif_path() { printf '%s/%s' "$VISIONKB_IMAGES_DIR" "$(sif_name "$(image_ref "$1")")"; }

cmd_pull() {
  local force=0 services=() s
  while (($#)); do
    case "$1" in
    --force) force=1 ;;
    -*) die "pull: unknown option $1" ;;
    *) services+=("$1") ;;
    esac
    shift
  done
  ((${#services[@]})) || read -r -a services <<<"$VISIONKB_SERVICES"
  resolve_paths
  ensure_apptainer
  mkdir -p "$VISIONKB_IMAGES_DIR"
  export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$VISIONKB_DEPLOY_DIR/apptainer-cache}"
  local failed=0
  for s in "${services[@]}"; do
    local ref sif src
    ref="$(image_ref "$s")"
    sif="$(sif_path "$s")"
    src="$(pull_source "$ref")"
    if [[ -f "$sif" && "$force" == 0 ]]; then
      log "pull $s: $sif exists (use --force to re-pull)"
      continue
    fi
    log "pull $s: $src -> $sif"
    if apptainer pull --force "$sif.partial" "$src" >&2; then
      mv -f "$sif.partial" "$sif"
      printf '%s\n' "$ref" >"$sif.ref"
    else
      rm -f "$sif.partial"
      log "pull $s: FAILED ($src)"
      failed=1
    fi
  done
  ((failed == 0)) || die "one or more images could not be pulled"
}

# ---------------------------------------------------------------------------------------------
# init / secrets
# ---------------------------------------------------------------------------------------------

random_token() {
  local out=""
  while ((${#out} < ${1:-32})); do
    out+="$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9')"
  done
  printf '%s' "${out:0:${1:-32}}"
}

write_secret() {
  local path="$1" value="$2"
  if [[ -s "$path" ]]; then
    log "init: keeping existing $(basename "$path")"
    return 0
  fi
  (
    umask 077
    printf '%s\n' "$value" >"$path.tmp"
  )
  mv "$path.tmp" "$path"
  chmod 600 "$path"
  log "init: wrote $(basename "$path") (mode 600)"
}

cmd_init() {
  (($# == 0)) || die "init takes no arguments"
  resolve_paths
  umask 077
  mkdir -p "$INST" "$SECRETS" "$STATE" "$RUNDIR" "$INST/tmp" \
    "$INST/neo4j/loaded" "$INST/neo4j/logs" "$INST/neo4j/conf" \
    "$INST/postgres/data" "$INST/postgres/run" "$INST/bundles"
  chmod 700 "$INST" "$SECRETS" "$INST/postgres/data"
  write_secret "$SECRETS/neo4j_password" "$(random_token 32)"
  write_secret "$SECRETS/pg_password" "$(random_token 32)"
  local pgpw read_token
  pgpw="$(tr -d '\r\n' <"$SECRETS/pg_password")"
  write_secret "$SECRETS/pg_dsn" "postgresql://visionkb:${pgpw}@${VISIONKB_PG_HOST}:${VISIONKB_PG_PORT}/visionkb"
  read_token="$(random_token 40)"
  if [[ ! -s "$SECRETS/api_tokens" ]]; then
    write_secret "$SECRETS/api_tokens" "$(printf '%s\t%s' "$read_token" read)"
    write_secret "$SECRETS/api_token_read" "$read_token"
  else
    log "init: keeping existing api_tokens"
  fi
  # web: cookie signing key and one access code (>= 16 characters); existing files are kept, never rotated
  write_secret "$SECRETS/web_secret" "$(random_token 64)"
  write_secret "$SECRETS/web_access_codes" "$(random_token 24)"
  log "init: web access code(s): $SECRETS/web_access_codes (one per line; give them to the people who may log in)"
  log "init: instance '$VISIONKB_INSTANCE' at $INST"
}

need_init() { [[ -s "$SECRETS/neo4j_password" ]] || die "instance '$VISIONKB_INSTANCE' not initialised; run 'visionkb init'"; }

# ---------------------------------------------------------------------------------------------
# Release pointers
# ---------------------------------------------------------------------------------------------

pointer_get() { [[ -s "$STATE/$1" ]] && tr -d '[:space:]' <"$STATE/$1" || true; }
pointer_set() {
  printf '%s\n' "$2" >"$STATE/$1.tmp"
  mv "$STATE/$1.tmp" "$STATE/$1"
}
loaded_dir() { printf '%s/neo4j/releases/%s' "$STORE" "$1"; } # node-local store of a release
record_dir() { printf '%s/%s' "$RECORDS" "$1"; }                # persistent load record
json_field() { sed -n "s/.*\"$2\":\"\{0,1\}\([^\",}]*\).*/\1/p" "$1" | head -n 1; }
is_recorded() { [[ -s "$(record_dir "$1")/LOADED.json" && -s "$(record_dir "$1")/SOURCE" ]]; }
# store present on this node and (if recorded) from the same manifest as the record
is_loaded() {
  local st rec
  st="$(loaded_dir "$1")/LOADED.json"
  rec="$(record_dir "$1")/LOADED.json"
  [[ -s "$st" ]] || return 1
  [[ -s "$rec" ]] || return 0
  [[ "$(json_field "$st" manifest_sha256)" == "$(json_field "$rec" manifest_sha256)" ]]
}
release_source() { tr -d '\n' <"$(record_dir "$1")/SOURCE"; }

current_release() {
  local cur
  cur="$(pointer_get current)"
  [[ -n "$cur" ]] || die "no release loaded in instance '$VISIONKB_INSTANCE'; run 'visionkb load-release'"
  if ! is_loaded "$cur"; then
    is_recorded "$cur" && die "the store of current release $cur is not on this node ($(loaded_dir "$cur")): node-local stores vanish with the allocation; run 'visionkb ensure-loaded'"
    die "current release $cur is not loaded; run 'visionkb load-release $cur'"
  fi
  printf '%s' "$cur"
}

# ---------------------------------------------------------------------------------------------
# apptainer helpers
# ---------------------------------------------------------------------------------------------

instance_name() { printf 'visionkb-%s-%s' "$VISIONKB_INSTANCE" "$1"; }
instance_running() { apptainer instance list "$(instance_name "$1")" 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$(instance_name "$1")"; }
port_in_use() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
service_enabled() { [[ " $VISIONKB_SERVICES " == *" $1 "* ]]; }

# Run a command inside a running instance with a clean environment, from / (host cwd is not mounted).
inst_exec() { # inst_exec SERVICE [apptainer exec options] -- CMD...
  local svc="$1" opts=()
  shift
  while (($#)) && [[ "$1" != -- ]]; do
    opts+=("$1")
    shift
  done
  [[ "${1:-}" == -- ]] && shift
  (cd / && apptainer exec --cleanenv "${opts[@]}" "instance://$(instance_name "$svc")" "$@")
}

# Common isolation flags: private /tmp, no host env or home, HOME=/tmp.
APPTAINER_FLAGS=(--containall --no-home --home /tmp --cleanenv)

write_env_file() { # write_env_file FILE KEY=VALUE... (values single-quoted for apptainer's shell parser)
  local file="$1" kv
  shift
  (
    umask 077
    : >"$file"
    for kv in "$@"; do
      [[ "${kv#*=}" != *"'"* ]] || die "value for ${kv%%=*} contains a single quote"
      printf "%s='%s'\n" "${kv%%=*}" "${kv#*=}" >>"$file"
    done
  )
}

# The single-quoted scripts below run inside the container; their $... must not expand here.
# shellcheck disable=SC2016
neo4j_cypher() { # neo4j_cypher QUERY: run in the neo4j instance, password read inside the container
  inst_exec neo4j -- bash -c \
    'NEO4J_PASSWORD="$(tr -d "\r\n" </run/secrets/neo4j_password)" exec cypher-shell -a "bolt://127.0.0.1:$1" -u neo4j -d neo4j --format plain "$2"' \
    _ "$VISIONKB_NEO4J_BOLT_PORT" "$1"
}

# shellcheck disable=SC2016
pg_sql() { # pg_sql SQL
  inst_exec postgres -- bash -c \
    'PGPASSWORD="$(tr -d "\r\n" </run/secrets/pg_password)" exec psql -h 127.0.0.1 -p "$1" -U visionkb -d visionkb -v ON_ERROR_STOP=1 -Atc "$2"' \
    _ "$VISIONKB_PG_PORT" "$1"
}

api_health() { curl -fsS --max-time 10 "http://127.0.0.1:${VISIONKB_API_PORT}/v1/health"; }
# HTTP status of GET /v1/ready (visionkb-api >= 0.1.1): 200 only when the release is loaded and neo4j, summaries,
# postgres are all ok, else 503; 000 if nothing answers.
api_ready_code() { curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:${VISIONKB_API_PORT}/v1/ready" 2>/dev/null || true; }

# api_health_check JSON RELEASE: every component "ok" and data.release == RELEASE (prints a summary line)
api_health_check() {
  "$VISIONKB_PYTHON" -c '
import json, sys
d = json.loads(sys.argv[1]).get("data") or {}
bad = [k for k in ("neo4j", "summaries", "postgres") if (d.get(k) or {}).get("status") != "ok"]
if d.get("release") != sys.argv[2]:
    bad.append("release=%s" % d.get("release"))
print("release=%s neo4j=%s summaries=%s postgres=%s version=%s" % (d.get("release"),
      (d.get("neo4j") or {}).get("status"), (d.get("summaries") or {}).get("status"),
      (d.get("postgres") or {}).get("status"), d.get("version")))
sys.exit(1 if bad else 0)
' "$1" "$2"
}

wait_for() { # wait_for SERVICE CHECK_FN
  local svc="$1" check="$2" deadline=$((SECONDS + VISIONKB_START_TIMEOUT))
  until "$check" >/dev/null 2>&1; do
    instance_running "$svc" || die "$svc instance exited during start-up; see 'visionkb logs $svc'"
    ((SECONDS < deadline)) || die "$svc not ready after ${VISIONKB_START_TIMEOUT}s; see 'visionkb logs $svc'"
    sleep 2
  done
}
check_neo4j() { neo4j_cypher "RETURN 1"; }
check_postgres() { inst_exec postgres -- pg_isready -q -h 127.0.0.1 -p "$VISIONKB_PG_PORT"; }
check_api() { api_health; }

need_sif() {
  local sif
  sif="$(sif_path "$1")"
  [[ -f "$sif" ]] || die "$1 image not pulled ($sif); run 'visionkb pull $1'"
  printf '%s' "$sif"
}

start_postgres() {
  local sif env="$RUNDIR/postgres.env"
  sif="$(need_sif postgres)"
  port_in_use "$VISIONKB_PG_PORT" && die "port $VISIONKB_PG_PORT in use (set VISIONKB_PG_PORT)"
  mkdir -p "$INST/tmp/postgres"
  write_env_file "$env" POSTGRES_USER=visionkb POSTGRES_DB=visionkb \
    POSTGRES_PASSWORD_FILE=/run/secrets/pg_password \
    "POSTGRES_INITDB_ARGS=--auth-local=scram-sha-256 --auth-host=scram-sha-256"
  (cd / && apptainer instance run "${APPTAINER_FLAGS[@]}" --env-file "$env" \
    -B "$INST/postgres/data:/var/lib/postgresql/data" -B "$INST/postgres/run:/var/run/postgresql" \
    -B "$INST/tmp/postgres:/tmp" -B "$SECRETS/pg_password:/run/secrets/pg_password:ro" \
    "$sif" "$(instance_name postgres)" postgres -c "listen_addresses=$VISIONKB_BIND_ADDRESS" \
    -c "port=$VISIONKB_PG_PORT" -c unix_socket_directories=/var/run/postgresql) >&2
  wait_for postgres check_postgres
}

start_neo4j() {
  local sif rel env="$RUNDIR/neo4j.env" http=()
  sif="$(need_sif neo4j)"
  rel="$(current_release)"
  check_store_fs "$(loaded_dir "$rel")"
  port_in_use "$VISIONKB_NEO4J_BOLT_PORT" && die "port $VISIONKB_NEO4J_BOLT_PORT in use (set VISIONKB_NEO4J_BOLT_PORT)"
  if [[ "$VISIONKB_NEO4J_HTTP_PORT" == 0 ]]; then
    http=(NEO4J_server_http_enabled=false)
  else
    port_in_use "$VISIONKB_NEO4J_HTTP_PORT" && die "port $VISIONKB_NEO4J_HTTP_PORT in use (set VISIONKB_NEO4J_HTTP_PORT, 0 disables)"
    http=("NEO4J_server_http_listen__address=$VISIONKB_BIND_ADDRESS:$VISIONKB_NEO4J_HTTP_PORT")
  fi
  # The image's entrypoint writes NEO4J_* settings into $NEO4J_HOME/conf: give it a fresh writable copy.
  rm -rf "$INST/neo4j/conf"
  mkdir -p "$INST/neo4j/conf" "$STORE/neo4j/run" "$STORE/tmp/neo4j"
  (cd / && apptainer exec "${APPTAINER_FLAGS[@]}" -B "$INST/neo4j/conf:/out" "$sif" sh -c 'cp /var/lib/neo4j/conf/* /out/')
  write_env_file "$env" TINI_SUBREAPER=1 \
    "NEO4J_server_default__listen__address=$VISIONKB_BIND_ADDRESS" \
    "NEO4J_server_bolt_listen__address=$VISIONKB_BIND_ADDRESS:$VISIONKB_NEO4J_BOLT_PORT" \
    "${http[@]}" NEO4J_server_https_enabled=false \
    "NEO4J_server_memory_heap_initial__size=$VISIONKB_NEO4J_HEAP" \
    "NEO4J_server_memory_heap_max__size=$VISIONKB_NEO4J_HEAP" \
    "NEO4J_server_memory_pagecache_size=$VISIONKB_NEO4J_PAGECACHE" \
    "NEO4J_server_databases_default__to__read__only=$VISIONKB_NEO4J_READ_ONLY" \
    NEO4J_initial_dbms_default__database=neo4j \
    NEO4J_server_fleet__discovery_enabled=false NEO4J_dbms_fleet__manager_enabled=false \
    NEO4J_dbms_usage__report_enabled=false
  (cd / && apptainer instance run "${APPTAINER_FLAGS[@]}" --env-file "$env" \
    -B "$INST/neo4j/conf:/var/lib/neo4j/conf" -B "$(loaded_dir "$rel")/data:/data" \
    -B "$INST/neo4j/logs:/logs" -B "$STORE/neo4j/run:/var/lib/neo4j/run" -B "$STORE/tmp/neo4j:/tmp" \
    -B "$SECRETS/neo4j_password:/run/secrets/neo4j_password:ro" \
    "$sif" "$(instance_name neo4j)") >&2
  wait_for neo4j check_neo4j
  log "neo4j serving $rel on bolt://$VISIONKB_BIND_ADDRESS:$VISIONKB_NEO4J_BOLT_PORT"
}

start_api() {
  local sif rel env="$RUNDIR/api.env"
  sif="$(need_sif api)"
  rel="$(current_release)"
  port_in_use "$VISIONKB_API_PORT" && die "port $VISIONKB_API_PORT in use (set VISIONKB_API_PORT)"
  mkdir -p "$INST/tmp/api"
  write_env_file "$env" "VISIONKB_KG_RELEASE=$rel" VISIONKB_RELEASE_DIR=/release \
    "NEO4J_URI=bolt://127.0.0.1:$VISIONKB_NEO4J_BOLT_PORT" NEO4J_USER=neo4j NEO4J_DATABASE=neo4j \
    "VISIONKB_VERIFY_CHECKSUMS=$VISIONKB_VERIFY_CHECKSUMS" \
    NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password VISIONKB_PG_DSN_FILE=/run/secrets/pg_dsn \
    VISIONKB_API_TOKENS_FILE=/run/secrets/api_tokens "VISIONKB_API_HOST=$VISIONKB_API_HOST" \
    "VISIONKB_API_PORT=$VISIONKB_API_PORT" "VISIONKB_MAX_ROWS=$VISIONKB_MAX_ROWS"
  (cd / && apptainer instance run "${APPTAINER_FLAGS[@]}" --env-file "$env" \
    -B "$(release_source "$rel"):/release:ro" -B "$INST/tmp/api:/tmp" \
    -B "$SECRETS/neo4j_password:/run/secrets/neo4j_password:ro" -B "$SECRETS/pg_dsn:/run/secrets/pg_dsn:ro" \
    -B "$SECRETS/api_tokens:/run/secrets/api_tokens:ro" "$sif" "$(instance_name api)") >&2
  wait_for api check_api # the process answers /v1/health; then report readiness
  local ready deadline=$((SECONDS + 60))
  until ready="$(api_ready_code)"; [[ "$ready" == 200 ]] || ((SECONDS >= deadline)); do sleep 2; done
  log "api serving $rel on http://$VISIONKB_API_HOST:$VISIONKB_API_PORT/v1 (GET /v1/ready: $ready)"
  [[ "$ready" == 200 ]] || log "WARNING: api is up but not ready (/v1/ready $ready); see 'visionkb health'"
}

# web (visionkb-web): home page + KG proxy + chat with the user's own Claude key (entered in the browser; the deploy
# never passes any Anthropic key). The instance gets an explicit env file; --cleanenv drops the host environment, and
# APPTAINERENV_*/SINGULARITYENV_* (which apptainer injects even with --cleanenv) and ANTHROPIC_* are removed from
# the apptainer process itself.
web_url() { printf 'http://127.0.0.1:%s' "$VISIONKB_WEB_PORT"; }
web_api_url() { printf '%s' "${VISIONKB_WEB_API_URL:-http://127.0.0.1:$VISIONKB_API_PORT/v1}"; }
web_healthz() { curl -fsS --max-time 5 "$(web_url)/healthz"; }
web_readyz() { curl -sS --max-time 10 -w '\n%{http_code}' "$(web_url)/readyz" 2>/dev/null || true; }
check_web() { web_healthz; }
clean_env_args() { # env(1) arguments that remove host variables apptainer would forward despite --cleanenv
  local v
  printf '%s\n' -i PATH="${PATH}" HOME="${HOME:-/tmp}" USER="${USER:-$(id -un)}" LANG=C.UTF-8
  for v in $(compgen -e); do
    case "$v" in APPTAINER_* | SINGULARITY_* | XDG_RUNTIME_DIR | DBUS_SESSION_BUS_ADDRESS) printf '%s=%s\n' "$v" "${!v}" ;; esac
  done
}

start_web() {
  local sif env="$RUNDIR/web.env" f
  sif="$(need_sif web)"
  port_in_use "$VISIONKB_WEB_PORT" && die "port $VISIONKB_WEB_PORT in use (set VISIONKB_WEB_PORT)"
  for f in api_token_read web_secret web_access_codes; do
    [[ -s "$SECRETS/$f" ]] || die "secret $f missing; run 'visionkb init' (keeps existing secrets, adds missing ones)"
  done
  mkdir -p "$INST/tmp/web"
  local opt=()
  [[ -z "${VISIONKB_WEB_ROOT_PATH:-}" ]] || opt+=("VISIONKB_WEB_ROOT_PATH=$VISIONKB_WEB_ROOT_PATH")
  [[ -z "${VISIONKB_WEB_DEFAULT_MODEL:-}" ]] || opt+=("VISIONKB_WEB_DEFAULT_MODEL=$VISIONKB_WEB_DEFAULT_MODEL")
  write_env_file "$env" "VISIONKB_API_URL=$(web_api_url)" VISIONKB_API_TOKEN_FILE=/run/secrets/api_token_read \
    "VISIONKB_WEB_HOST=$VISIONKB_WEB_HOST" "VISIONKB_WEB_PORT=$VISIONKB_WEB_PORT" \
    VISIONKB_WEB_SECRET_FILE=/run/secrets/web_secret VISIONKB_WEB_ACCESS_CODES_FILE=/run/secrets/web_access_codes \
    "VISIONKB_WEB_PUBLIC=$VISIONKB_WEB_PUBLIC" HOME=/tmp "${opt[@]}"
  local envargs=()
  mapfile -t envargs < <(clean_env_args)
  (cd / && env "${envargs[@]}" apptainer instance run "${APPTAINER_FLAGS[@]}" --env-file "$env" -B "$INST/tmp/web:/tmp" \
    -B "$SECRETS/api_token_read:/run/secrets/api_token_read:ro" -B "$SECRETS/web_secret:/run/secrets/web_secret:ro" \
    -B "$SECRETS/web_access_codes:/run/secrets/web_access_codes:ro" "$sif" "$(instance_name web)") >&2
  local deadline=$((SECONDS + VISIONKB_WEB_START_TIMEOUT)) out code
  until web_healthz >/dev/null 2>&1; do
    instance_running web || die "web instance exited during start-up; see 'visionkb logs web'"
    ((SECONDS < deadline)) || die "web not answering /healthz after ${VISIONKB_WEB_START_TIMEOUT}s; see 'visionkb logs web'"
    sleep 3
  done
  until out="$(web_readyz)"; code="${out##*$'\n'}"; [[ "$code" == 200 ]] || ((SECONDS >= deadline)); do sleep 3; done
  log "web serving on http://$VISIONKB_WEB_HOST:$VISIONKB_WEB_PORT/ (GET /readyz: $code; access codes in $SECRETS/web_access_codes)"
  [[ "$code" == 200 ]] || log "WARNING: web is up but not ready (/readyz $code); see 'visionkb health'"
}

stop_service() {
  local svc="$1" name
  name="$(instance_name "$svc")"
  if ! instance_running "$svc"; then
    log "stop $svc: not running"
    return 0
  fi
  if [[ "$svc" == postgres ]]; then
    inst_exec postgres -- pg_ctl -D /var/lib/postgresql/data stop -m fast -t "$VISIONKB_STOP_TIMEOUT" >&2 || true
    local i
    for ((i = 0; i < 10; i++)); do
      instance_running postgres || break
      sleep 1
    done
  fi
  if instance_running "$svc"; then
    apptainer instance stop -t "$VISIONKB_STOP_TIMEOUT" "$name" >&2
  fi
  log "stop $svc: stopped"
}

select_services() { # select_services ORDER ARGS... -> prints services in ORDER that are requested
  local order="$1" s want
  shift
  for s in "$@"; do
    case "$s" in postgres | neo4j | api | web) ;; *) die "unknown service '$s'" ;; esac
  done
  if (($#)); then
    want=" $* "
  else
    want=" $VISIONKB_SERVICES "
  fi
  for s in $order; do
    if [[ "$want" == *" $s "* ]]; then
      printf '%s\n' "$s"
    fi
  done
}

cmd_start() {
  local s list
  list="$(select_services "postgres neo4j api web" "$@")"
  resolve_paths
  ensure_apptainer
  need_init
  for s in $list; do
    if instance_running "$s"; then
      log "start $s: already running"
      continue
    fi
    log "start $s"
    "start_$s"
  done
}

cmd_stop() {
  local s list
  list="$(select_services "web api neo4j postgres" "$@")"
  resolve_paths
  ensure_apptainer
  for s in $list; do
    stop_service "$s"
  done
}

cmd_restart() {
  cmd_stop "$@"
  cmd_start "$@"
}

# Restart neo4j/api if they are running (after the current pointer moved).
reload_serving() {
  local s to_restart=()
  for s in neo4j api; do
    if instance_running "$s"; then
      to_restart+=("$s")
    fi
  done
  if ((${#to_restart[@]})); then
    log "restarting ${to_restart[*]} to serve $(pointer_get current)"
    cmd_stop "${to_restart[@]}"
    cmd_start "${to_restart[@]}"
  fi
}

# ---------------------------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------------------------

resolve_release_dir() { # ID or DIR -> directory
  if [[ -d "$1" ]]; then
    (cd "$1" && pwd -P)
  else
    check_release_id "$1"
    need_releases_dir
    [[ -d "$VISIONKB_RELEASES_DIR/$1" ]] || die "release $1 not found in $VISIONKB_RELEASES_DIR"
    printf '%s/%s' "$VISIONKB_RELEASES_DIR" "$1"
  fi
}

cmd_verify_release() {
  (($# == 1)) || die "usage: visionkb verify-release ID|DIR"
  resolve_paths
  python_bundle verify-dir "$(resolve_release_dir "$1")"
}

cmd_unpack_bundle() {
  local tar="" dest=""
  while (($#)); do
    case "$1" in
    --dest)
      dest="${2:?--dest needs a directory}"
      shift
      ;;
    -*) die "unpack-bundle: unknown option $1" ;;
    *) tar="$1" ;;
    esac
    shift
  done
  [[ -n "$tar" ]] || die "usage: visionkb unpack-bundle TAR [--dest DIR]"
  resolve_paths
  python_bundle unpack "$tar" --dest "${dest:-$INST/bundles}" "$(pin_arg)"
}

cmd_export_bundle() {
  local rel="" out=""
  while (($#)); do
    case "$1" in
    --out)
      out="${2:?--out needs a directory}"
      shift
      ;;
    -*) die "export-bundle: unknown option $1" ;;
    *) rel="$1" ;;
    esac
    shift
  done
  [[ -n "$rel" ]] || die "usage: visionkb export-bundle ID [--out DIR]"
  check_release_id "$rel"
  resolve_paths
  out="${out:-${VISIONKB_BUNDLES_DIR:-}}"
  [[ -n "$out" ]] || die "set VISIONKB_DATA_ROOT, VISIONKB_BUNDLES_DIR or --out"
  local tar="$out/$rel.tar"
  if [[ -f "$tar" ]]; then
    log "export-bundle: $tar exists; verifying it"
  elif command -v visionkb-kg >/dev/null 2>&1 && [[ "$out" == "${VISIONKB_BUNDLES_DIR:-}" ]]; then
    log "export-bundle: running visionkb-kg pack $rel"
    visionkb-kg pack "$rel" >&2
  else
    log "export-bundle: packing $(resolve_release_dir "$rel") (visionkb-kg not on PATH or --out given)"
    python_bundle pack "$(resolve_release_dir "$rel")" --out "$out" >&2
  fi
  python_bundle verify-bundle "$tar" >&2
  local tmpd
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}/visionkb-verify.XXXXXX")"
  python_bundle unpack "$tar" --dest "$tmpd" --release "$rel" >/dev/null || {
    rm -rf "$tmpd"
    die "bundle $tar does not unpack/verify"
  }
  chmod -R u+w "$tmpd" && rm -rf "$tmpd"
  cat <<EOF
Bundle ready and verified (outer sha256 + every manifest checksum):
  $tar
  $tar.sha256
Copy both files to the Eye server (it cannot read this filesystem), e.g. from a machine that can reach both:
  scp <hpc-login>:$tar <hpc-login>:$tar.sha256 .
  scp $rel.tar $rel.tar.sha256 <eye-server>:/path/to/bundles/
or publish them at an HTTPS / object-store URL for the fetch-bundle overlay. On the Eye server:
  sha256sum -c $rel.tar.sha256
  bin/visionkb-k8s upload-bundle /path/to/bundles/$rel.tar      # local-bundle overlay
  bin/visionkb-k8s fetch-bundle $rel                             # fetch-bundle overlay
EOF
}

cmd_load_release() {
  local rel="" from="" bundle="" force=0 activate=1 restart=1 expected_opt=""
  while (($#)); do
    case "$1" in
    --expected-ids)
      expected_opt="${2:?--expected-ids needs a directory}"
      shift
      ;;
    --from)
      from="${2:?--from needs a directory}"
      shift
      ;;
    --bundle)
      bundle="${2:?--bundle needs a .tar}"
      shift
      ;;
    --force) force=1 ;;
    --no-activate) activate=0 ;;
    --no-restart) restart=0 ;;
    -*) die "load-release: unknown option $1" ;;
    *)
      [[ -z "$rel" ]] || die "load-release: one release at a time"
      rel="$1"
      ;;
    esac
    shift
  done
  [[ -n "$from" && -n "$bundle" ]] && die "load-release: use --from or --bundle, not both"
  if [[ -n "$bundle" ]]; then
    [[ -n "$rel" ]] || rel="$(basename "$bundle" .tar)"
  fi
  rel="${rel:-${VISIONKB_KG_RELEASE:-}}"
  [[ -n "$rel" ]] || die "usage: visionkb load-release ID (or set VISIONKB_KG_RELEASE)"
  check_release_id "$rel"
  resolve_paths
  ensure_apptainer
  need_init
  if [[ -n "$bundle" ]]; then
    python_bundle unpack "$bundle" --dest "$INST/bundles" --release "$rel" "$(pin_arg)" >&2
    from="$INST/bundles"
  fi
  local src
  if [[ -n "$from" ]]; then
    [[ -d "$from/$rel" ]] || die "$from/$rel not found"
    src="$(cd "$from/$rel" && pwd -P)"
  else
    src="$(resolve_release_dir "$rel")"
  fi
  log "load-release $rel: verifying $src"
  python_bundle verify-dir "$src" --release "$rel" >&2

  local target record
  target="$(loaded_dir "$rel")"
  record="$(record_dir "$rel")"
  check_store_fs "$target"
  if is_loaded "$rel" && [[ "$force" == 0 ]]; then
    die "$rel already loaded on this node; 'visionkb rollback $rel' serves it, --force re-imports"
  fi
  if [[ -e "$target" || -e "$target.partial" ]]; then
    if [[ "$(pointer_get current)" == "$rel" ]] && instance_running neo4j; then
      die "$rel is being served; stop neo4j or roll back before --force"
    fi
    log "load-release $rel: removing previous/stale store $target"
    chmod -R u+w "$target" "$target.partial" 2>/dev/null || true
    rm -rf "$target" "$target.partial"
  fi
  port_in_use "$VISIONKB_NEO4J_LOAD_BOLT_PORT" && die "load port $VISIONKB_NEO4J_LOAD_BOLT_PORT in use (set VISIONKB_NEO4J_LOAD_BOLT_PORT)"
  local sif env="$RUNDIR/load.env" logf="$INST/neo4j/logs/load-$rel.log" scratch="$STORE/tmp/load" exp
  sif="$(need_sif neo4j)"
  mkdir -p "$scratch" "$STORE/neo4j/releases"
  if [[ -n "$expected_opt" ]]; then
    exp="$(cd "$expected_opt" && pwd -P)"
  else
    exp="$scratch/expected-$rel"
    rm -rf "$exp"
    log "load-release $rel: expected node ids / relationship keys from the import CSVs"
    python_bundle expected-ids "$src" --out "$exp" >&2
  fi
  write_env_file "$env" "VISIONKB_KG_RELEASE=$rel" VISIONKB_RELEASE_DIR=/release \
    "VISIONKB_TARGET_DIR=/releases/$rel" NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password \
    "VISIONKB_LOAD_BOLT_PORT=$VISIONKB_NEO4J_LOAD_BOLT_PORT" "VISIONKB_LOAD_HEAP=$VISIONKB_LOAD_HEAP" \
    "VISIONKB_LOAD_PAGECACHE=$VISIONKB_LOAD_PAGECACHE" "VISIONKB_START_TIMEOUT=$VISIONKB_START_TIMEOUT" \
    VISIONKB_EXPECTED_IDS_DIR=/expected
  log "load-release $rel: importing into $target ($(fs_type "$STORE")) (log: $logf)"
  local rc=0
  (cd / && apptainer exec "${APPTAINER_FLAGS[@]}" --env-file "$env" -B "$src:/release:ro" \
    -B "$STORE/neo4j/releases:/releases" -B "$scratch:/tmp" -B "$exp:/expected:ro" \
    -B "$SECRETS/neo4j_password:/run/secrets/neo4j_password:ro" -B "$REPO_DIR/libexec:/opt/visionkb-deploy:ro" \
    "$sif" bash /opt/visionkb-deploy/neo4j-load-release.sh) >"$logf" 2>&1 || rc=$?
  ((rc == 0)) || {
    tail -n 30 "$logf" >&2
    die "load-release $rel failed (exit $rc); full log: $logf"
  }
  grep '^VISIONKB_LOAD_RESULT ' "$logf" | tail -n 1 >&2
  [[ -s "$target/LOADED.json" ]] || die "load finished but $target/LOADED.json is missing"
  # contracts v0.8 section 13: the imported totals must equal the manifest's nodes_total / edges_total
  if ! python_bundle compare-counts "$src" "$target/LOADED.json" >&2; then
    mv "$target" "$target.partial"
    [[ -n "$expected_opt" ]] || rm -rf "$exp"
    die "load-release $rel: imported totals differ from the manifest counts; store unpublished ($target.partial), no record, pointers unchanged"
  fi
  # persistent record: what was loaded, from where, how it was checked
  rm -rf "$record"
  mkdir -p "$record"
  cp "$target/LOADED.json" "$record/LOADED.json"
  cp -r "$target/load-logs" "$record/load-logs"
  cp "$exp/ids.json" "$record/expected-ids.json"
  printf '%s\n' "$src" >"$record/SOURCE"
  printf '%s\n' "$target" >"$record/STORE"
  [[ -n "$expected_opt" ]] || rm -rf "$exp"
  if [[ "$activate" == 1 ]]; then
    local cur
    cur="$(pointer_get current)"
    if [[ "$cur" != "$rel" ]]; then
      [[ -n "$cur" ]] && pointer_set previous "$cur"
      pointer_set current "$rel"
    fi
    log "load-release $rel: current=$rel previous=$(pointer_get previous)"
    [[ "$restart" == 1 ]] && reload_serving
  fi
  return 0
}

# Re-import RELEASE on this node from its recorded source (the store vanished with an old allocation).
reload_from_record() {
  local rel="$1" src
  is_recorded "$rel" || die "$rel has no load record in instance '$VISIONKB_INSTANCE'; run 'visionkb load-release $rel'"
  src="$(release_source "$rel")"
  [[ -d "$src" ]] || die "recorded source of $rel is gone: $src"
  log "re-importing $rel on this node from $src (its node-local store is missing)"
  cmd_load_release "$rel" --from "$(dirname "$src")" --no-activate --no-restart
}

cmd_ensure_loaded() {
  local with_prev=0 r ids=()
  case "${1:-}" in "") ;; --with-previous) with_prev=1 ;; *) die "usage: visionkb ensure-loaded [--with-previous]" ;; esac
  resolve_paths
  ensure_apptainer
  need_init
  r="$(pointer_get current)"
  [[ -n "$r" ]] || die "no current release in instance '$VISIONKB_INSTANCE'; run 'visionkb load-release ID'"
  ids+=("$r")
  r="$(pointer_get previous)"
  ((with_prev)) && [[ -n "$r" ]] && ids+=("$r")
  for r in "${ids[@]}"; do
    if is_loaded "$r"; then
      log "ensure-loaded: $r present on this node ($(loaded_dir "$r"))"
    else
      reload_from_record "$r"
    fi
  done
}

cmd_rollback() {
  (($# <= 1)) || die "usage: visionkb rollback [ID]"
  [[ -z "${1:-}" ]] || check_release_id "$1"
  resolve_paths
  ensure_apptainer
  local cur target
  cur="$(pointer_get current)"
  target="${1:-$(pointer_get previous)}"
  [[ -n "$target" ]] || die "no previous release recorded; give a release id"
  check_release_id "$target"
  [[ "$target" != "$cur" ]] || die "$target is already current"
  if ! is_loaded "$target"; then
    is_recorded "$target" || die "$target is not loaded in instance '$VISIONKB_INSTANCE' (see 'visionkb releases')"
    need_init
    reload_from_record "$target"
  fi
  [[ -n "$cur" ]] && pointer_set previous "$cur"
  pointer_set current "$target"
  log "rollback: current=$target previous=$cur"
  reload_serving
}

cmd_releases() {
  resolve_paths
  local cur prev d r where
  cur="$(pointer_get current)"
  prev="$(pointer_get previous)"
  printf 'current:  %s\nprevious: %s\nstore dir: %s (%s)\nloaded (records):\n' "${cur:-none}" "${prev:-none}" "$STORE" "$(fs_type "$STORE")"
  shopt -s nullglob
  for d in "$RECORDS"/*/; do
    r="$(basename "${d%/}")"
    if is_loaded "$r"; then where="store on this node"; else where="store NOT on this node (ensure-loaded / rollback re-imports)"; fi
    printf '  %-24s %s\n  %-24s %s\n' "$r" "$where" "" "$(cat "$d/LOADED.json" 2>/dev/null || echo '(incomplete record)')"
  done
  if [[ -d "$INST/neo4j/releases" ]]; then
    printf 'note: %s holds stores from visionkb-deploy <= 0.1.1 on the deploy dir; they are not used any more (remove them)\n' "$INST/neo4j/releases"
  fi
}

# ---------------------------------------------------------------------------------------------
# status / health / logs
# ---------------------------------------------------------------------------------------------

service_port() {
  case "$1" in
  neo4j) printf '%s' "$VISIONKB_NEO4J_BOLT_PORT" ;;
  postgres) printf '%s' "$VISIONKB_PG_PORT" ;;
  api) printf '%s' "$VISIONKB_API_PORT" ;;
  web) printf '%s' "$VISIONKB_WEB_PORT" ;;
  esac
}

cmd_status() {
  resolve_paths
  ensure_apptainer
  local s state listen
  printf 'instance: %s (%s)\n' "$VISIONKB_INSTANCE" "$INST"
  for s in $ALL_SERVICES; do
    state="stopped"
    instance_running "$s" && state="running"
    service_enabled "$s" || state="$state (not in VISIONKB_SERVICES)"
    listen="closed"
    port_in_use "$(service_port "$s")" && listen="open"
    printf '  %-9s %-36s port %-5s %s\n' "$s" "$state" "$(service_port "$s")" "$listen"
  done
  cmd_releases
}

cmd_health() {
  resolve_paths
  ensure_apptainer
  local bad=0 out cur
  cur="$(pointer_get current)"
  if service_enabled postgres; then
    if instance_running postgres && out="$(pg_sql 'select 1' 2>/dev/null)" && [[ "$out" == 1 ]]; then
      echo "postgres: ok (SELECT 1 on 127.0.0.1:$VISIONKB_PG_PORT)"
    else
      echo "postgres: DOWN ${out:-}"
      bad=1
    fi
  fi
  if service_enabled neo4j; then
    local q="MATCH (n) WITH count(n) AS nodes OPTIONAL MATCH ()-[r]->() WITH nodes, r LIMIT 1 RETURN nodes, r.kg_release AS release"
    if instance_running neo4j && out="$(neo4j_cypher "$q" 2>/dev/null | tail -n 1)"; then
      echo "neo4j: ok (Cypher ping; nodes, edge kg_release = $out; current pointer $cur)"
      [[ "$out" == *"\"$cur\""* ]] || echo "neo4j: WARNING: edge kg_release does not match current pointer $cur"
    else
      echo "neo4j: DOWN ${out:-}"
      bad=1
    fi
  fi
  if service_enabled api; then
    local summary
    if out="$(api_health 2>&1)" && summary="$(api_health_check "$out" "$cur")"; then
      echo "api: ok (GET /v1/health: $summary)"
    elif [[ -n "${summary:-}" ]]; then
      echo "api: DEGRADED (GET /v1/health: $summary)"
      bad=1
    else
      echo "api: DOWN (GET http://127.0.0.1:$VISIONKB_API_PORT/v1/health: ${out:-no answer})"
      bad=1
    fi
    local ready
    ready="$(api_ready_code)"
    if [[ "$ready" == 200 ]]; then
      echo "api: ready (GET /v1/ready: 200)"
    else
      echo "api: NOT READY (GET /v1/ready: $ready)"
      bad=1
    fi
  else
    echo "api: skipped (not in VISIONKB_SERVICES)"
  fi
  if service_enabled web; then
    local body code ntools krel
    if out="$(web_healthz 2>&1)"; then
      echo "web: ok (GET /healthz: $out)"
    else
      echo "web: DOWN (GET $(web_url)/healthz: ${out:-no answer})"
      bad=1
    fi
    body="$(web_readyz)"
    code="${body##*$'\n'}"
    body="${body%$'\n'*}"
    ntools="$(sed -n 's/.*"n_tools":\([0-9]*\).*/\1/p' <<<"$body")"
    krel="$(sed -n 's/.*"kg_release":"\([^"]*\)".*/\1/p' <<<"$body")"
    if [[ "$code" == 200 ]]; then
      echo "web: ready (GET /readyz: 200; mcp tools ${ntools:-?}; kg_release ${krel:-?})"
    else
      echo "web: NOT READY (GET /readyz: ${code:-no answer}; mcp tools ${ntools:-?})"
      bad=1
    fi
  fi
  return "$bad"
}

cmd_logs() {
  (($# == 1)) || die "usage: visionkb logs SERVICE"
  resolve_paths
  local name logs
  name="$(instance_name "$1")"
  logs="${APPTAINER_INSTANCE_LOGS:-$HOME/.apptainer/instances/logs}"
  echo "instance stdout/stderr: $logs/*/$(id -un)/$name.{out,err}"
  case "$1" in
  neo4j) echo "neo4j logs: $INST/neo4j/logs/ (load logs: load-<release>.log, <store>/load-logs/)" ;;
  postgres) echo "postgres logs: instance stderr above" ;;
  api) echo "api logs: instance stdout/stderr above (the API logs to stdout)" ;;
  web) echo "web logs: instance stdout/stderr above (Claude keys are never logged: redacted, headers dropped)" ;;
  *) die "unknown service $1" ;;
  esac
}

# ---------------------------------------------------------------------------------------------
# backup / restore
# ---------------------------------------------------------------------------------------------

# shellcheck disable=SC2016
cmd_backup() {
  (($# == 0)) || die "backup takes no arguments"
  resolve_paths
  ensure_apptainer
  [[ -n "${VISIONKB_BACKUP_DIR:-}" ]] || die "set VISIONKB_BACKUP_DIR (or VISIONKB_DATA_ROOT)"
  instance_running postgres || die "postgres is not running; 'visionkb start postgres' first"
  local ts dir
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dir="$VISIONKB_BACKUP_DIR/$ts"
  umask 027
  mkdir -p "$dir.partial"
  inst_exec postgres -- bash -c \
    'PGPASSWORD="$(tr -d "\r\n" </run/secrets/pg_password)" exec pg_dump -h 127.0.0.1 -p "$1" -U visionkb -d visionkb -Fc' \
    _ "$VISIONKB_PG_PORT" >"$dir.partial/proposals.pgdump"
  [[ -s "$dir.partial/proposals.pgdump" ]] || die "pg_dump wrote nothing"
  local cur prev
  cur="$(pointer_get current)"
  prev="$(pointer_get previous)"
  [[ -n "$cur" ]] && cp "$(record_dir "$cur")/LOADED.json" "$dir.partial/current-LOADED.json"
  printf '{"created_utc":"%s","instance":"%s","current":"%s","previous":"%s","pgdump_sha256":"%s","deploy_version":"%s"}\n' \
    "$ts" "$VISIONKB_INSTANCE" "$cur" "$prev" "$(sha256sum "$dir.partial/proposals.pgdump" | cut -d' ' -f1)" \
    "$VISIONKB_DEPLOY_VERSION" >"$dir.partial/backup.json"
  mv "$dir.partial" "$dir"
  echo "$dir"
}

# shellcheck disable=SC2016
cmd_restore() {
  local dir="" yes=0
  while (($#)); do
    case "$1" in
    --yes) yes=1 ;;
    -*) die "restore: unknown option $1" ;;
    *) dir="$1" ;;
    esac
    shift
  done
  [[ -n "$dir" && -s "$dir/proposals.pgdump" ]] || die "usage: visionkb restore BACKUP_DIR --yes (needs proposals.pgdump)"
  [[ "$yes" == 1 ]] || die "restore replaces the proposals database; add --yes"
  resolve_paths
  ensure_apptainer
  instance_running postgres || die "postgres is not running"
  # A running instance cannot gain new binds: stream the dump on stdin.
  inst_exec postgres -- bash -c \
    'PGPASSWORD="$(tr -d "\r\n" </run/secrets/pg_password)" exec pg_restore -h 127.0.0.1 -p "$1" -U visionkb -d visionkb --clean --if-exists --no-owner' \
    _ "$VISIONKB_PG_PORT" <"$dir/proposals.pgdump"
  log "restore: $dir/proposals.pgdump restored"
}

cmd_cypher() {
  (($# == 1)) || die "usage: visionkb cypher QUERY"
  resolve_paths
  ensure_apptainer
  instance_running neo4j || die "neo4j is not running"
  neo4j_cypher "$1"
}

cmd_tunnel_hint() { # tunnel-hint [NODE]: ssh -L for the enabled services that clients use (api, web)
  local node="${1:-$(hostname -s)}" fwd="" s
  for s in api web; do
    service_enabled "$s" || continue
    fwd+=" -L $(service_port "$s"):127.0.0.1:$(service_port "$s")"
  done
  [[ -n "$fwd" ]] || die "tunnel-hint: neither api nor web is in VISIONKB_SERVICES"
  echo "services are on 127.0.0.1 of $node. From your laptop:"
  echo "  ssh -N$fwd -J <user>@<login-host> <user>@$node"
  if service_enabled api; then echo "then: curl http://127.0.0.1:$VISIONKB_API_PORT/v1/health"; fi
  if service_enabled web; then
    echo "web page: http://127.0.0.1:$VISIONKB_WEB_PORT/ (access code: first line of <instance>/secrets/web_access_codes)"
  fi
}

cmd_config() {
  resolve_paths
  local v
  for v in VISIONKB_ENV_FILE VISIONKB_INSTANCE VISIONKB_SERVICES VISIONKB_DATA_ROOT VISIONKB_WORK_DIR \
    VISIONKB_DEPLOY_DIR VISIONKB_IMAGES_DIR VISIONKB_RELEASES_DIR VISIONKB_BUNDLES_DIR VISIONKB_BACKUP_DIR \
    VISIONKB_KG_RELEASE VISIONKB_KG_BUNDLE_SHA256 VISIONKB_NEO4J_IMAGE VISIONKB_POSTGRES_IMAGE VISIONKB_API_IMAGE \
    VISIONKB_MCP_IMAGE VISIONKB_SKILLS_RELEASE VISIONKB_BIND_ADDRESS \
    VISIONKB_NEO4J_BOLT_PORT VISIONKB_NEO4J_HTTP_PORT VISIONKB_NEO4J_LOAD_BOLT_PORT VISIONKB_PG_PORT \
    VISIONKB_API_HOST VISIONKB_API_PORT VISIONKB_NEO4J_HEAP VISIONKB_NEO4J_PAGECACHE VISIONKB_NEO4J_READ_ONLY \
    VISIONKB_VERIFY_CHECKSUMS VISIONKB_PYTHON VISIONKB_STORE_DIR VISIONKB_ALLOW_NETWORK_STORE \
    VISIONKB_APPTAINER_MODULE VISIONKB_MODULES_INIT VISIONKB_WEB_IMAGE VISIONKB_WEB_HOST VISIONKB_WEB_PORT \
    VISIONKB_WEB_PUBLIC VISIONKB_WEB_ROOT_PATH VISIONKB_WEB_DEFAULT_MODEL VISIONKB_WEB_START_TIMEOUT; do
    printf '%s=%s\n' "$v" "${!v:-}"
  done
  printf 'instance_dir=%s\n' "$INST"
  [[ -z "${VISIONKB_MCP_IMAGE:-}" ]] || printf 'mcp_sif=%s\n' "$(sif_path mcp)"
  printf 'web_api_url=%s\n' "$(web_api_url)"
  printf 'web_url=http://%s:%s/\n' "$VISIONKB_WEB_HOST" "$VISIONKB_WEB_PORT"
  printf 'web_access_codes_file=%s\n' "$SECRETS/web_access_codes" # the path only; never the codes
  printf 'store_fs=%s\n' "$(fs_type "$STORE")"
}

# ---------------------------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------------------------

main() {
  OPT_ENV_FILE=""
  OPT_INSTANCE=""
  while (($#)); do
    case "$1" in
    --env-file)
      OPT_ENV_FILE="${2:?--env-file needs a file}"
      shift
      ;;
    --env-file=*) OPT_ENV_FILE="${1#*=}" ;;
    --instance)
      OPT_INSTANCE="${2:?--instance needs a name}"
      shift
      ;;
    --instance=*) OPT_INSTANCE="${1#*=}" ;;
    -h | --help | help)
      usage
      return 0
      ;;
    --version | version)
      echo "visionkb-deploy $VISIONKB_DEPLOY_VERSION"
      return 0
      ;;
    -*) die "unknown option $1 (see 'visionkb help')" ;;
    *) break ;;
    esac
    shift
  done
  (($#)) || {
    usage >&2
    return 2
  }
  local cmd="$1"
  shift
  load_settings
  case "$cmd" in
  pull) cmd_pull "$@" ;;
  init) cmd_init "$@" ;;
  config) cmd_config "$@" ;;
  verify-release) cmd_verify_release "$@" ;;
  export-bundle) cmd_export_bundle "$@" ;;
  unpack-bundle) cmd_unpack_bundle "$@" ;;
  load-release) cmd_load_release "$@" ;;
  rollback) cmd_rollback "$@" ;;
  ensure-loaded) cmd_ensure_loaded "$@" ;;
  releases) cmd_releases "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  status) cmd_status "$@" ;;
  health) cmd_health "$@" ;;
  logs) cmd_logs "$@" ;;
  cypher) cmd_cypher "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  tunnel-hint) cmd_tunnel_hint "$@" ;;
  *) die "unknown command '$cmd' (see 'visionkb help')" ;;
  esac
}

main "$@"
