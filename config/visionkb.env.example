# VisionKB deploy settings (contracts section 9). Copy to $VISIONKB_DATA_ROOT/config/visionkb.env (outside
# git) or pass with --env-file. Plain KEY=VALUE lines, no shell expansion (the same file is read by
# bin/visionkb and by docker compose `env_file:`). Secrets are never stored here: only *_FILE paths.
# Precedence in bin/visionkb: environment > this file > versions.env > built-in defaults.

# --- data roots (section 1) -------------------------------------------------------------------
VISIONKB_DATA_ROOT=/path/to/visionkb
VISIONKB_WORK_DIR=/path/to/visionkb-work
# Optional overrides (defaults shown):
# VISIONKB_DEPLOY_DIR=/path/to/visionkb-work/visionkb-deploy          # images/ and one folder per instance
# VISIONKB_RELEASES_DIR=/path/to/visionkb/kg/releases
# VISIONKB_BUNDLES_DIR=/path/to/visionkb/kg/bundles
# VISIONKB_BACKUP_DIR=/path/to/visionkb/backups/visionkb-deploy/<instance>

# --- what to run ------------------------------------------------------------------------------
# VISIONKB_INSTANCE=default
# VISIONKB_KG_RELEASE=visionkb-2026.11.0          # default comes from versions.env
VISIONKB_SERVICES=postgres neo4j api

# --- network (bind 127.0.0.1; on a shared node other users can still reach localhost ports,
#     so every service requires a password or token) -------------------------------------------
VISIONKB_BIND_ADDRESS=127.0.0.1
VISIONKB_NEO4J_BOLT_PORT=7687
# 0 disables the Neo4j HTTP/browser port
VISIONKB_NEO4J_HTTP_PORT=7474
VISIONKB_NEO4J_LOAD_BOLT_PORT=17687
VISIONKB_PG_PORT=5432
# Host written into the PG DSN secret by `init` (127.0.0.1 for apptainer, `postgres` for compose)
VISIONKB_PG_HOST=127.0.0.1
VISIONKB_API_HOST=127.0.0.1
VISIONKB_API_PORT=8770
VISIONKB_MAX_ROWS=200
# 1: visionkb-api re-checks every manifest checksum at start (deploy tooling already verifies before load)
VISIONKB_VERIFY_CHECKSUMS=0

# --- memory ----------------------------------------------------------------------------------
VISIONKB_NEO4J_HEAP=2g
VISIONKB_NEO4J_PAGECACHE=2g
VISIONKB_LOAD_HEAP=4g
VISIONKB_LOAD_PAGECACHE=2g
# Serve the graph read-only (the API never writes to Neo4j; proposals go to PostgreSQL)
VISIONKB_NEO4J_READ_ONLY=true

# --- client side (MCP server / skill) and API secrets: files, never values -----------------
# Generated by `visionkb init` under <deploy dir>/<instance>/secrets/ (mode 600):
#   neo4j_password, pg_password, pg_dsn, api_tokens (token<TAB>scopes), api_token_read
# VISIONKB_API_URL=http://127.0.0.1:8770/v1
# VISIONKB_API_TOKEN_FILE=/path/to/visionkb-work/visionkb-deploy/default/secrets/api_token_read

# --- site ------------------------------------------------------------------------------------
# Module to load when apptainer is not on PATH (and the modules init script, if `module` is missing)
# VISIONKB_APPTAINER_MODULE=apptainer/<version>
# VISIONKB_MODULES_INIT=/usr/share/Modules/init/bash
# python3 >= 3.9 used for manifest/bundle checks
# VISIONKB_PYTHON=python3
