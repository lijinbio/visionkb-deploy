# Copy to compose/.env (not committed). Used with: docker compose --env-file ../versions.env --env-file .env ...
# Settings shared with bin/visionkb (ports, memory, ...) live in the file VISIONKB_ENV_FILE points to.
VISIONKB_ENV_FILE=/path/to/visionkb.env
# Runtime state: <deploy dir>/<instance>/{secrets,bundles,neo4j,postgres,api,backups}; create it with
#   VISIONKB_DEPLOY_DIR=/path/to/visionkb-deploy-state VISIONKB_PG_HOST=postgres VISIONKB_PG_PORT=5432 bin/visionkb init
VISIONKB_DEPLOY_DIR=/path/to/visionkb-deploy-state
VISIONKB_INSTANCE=default
# Containers run as this (non-root) user; it must own the deploy dir. `id -u` / `id -g`.
VISIONKB_UID=1000
VISIONKB_GID=1000
# Published API address: keep 127.0.0.1 unless a reverse proxy on another host needs it.
VISIONKB_API_BIND=127.0.0.1
VISIONKB_API_PORT=8770
# Release to serve / load (overrides versions.env). Switch or roll back by editing this and `up -d`.
# VISIONKB_KG_RELEASE=visionkb-2026.11.0
# VISIONKB_BACKUP_DIR=/path/to/backups
