#!/usr/bin/env bash
# visionkb-k8s: deploy and operate VisionKB on Kubernetes (production: the Eye server, no HPC filesystem or HPC
# access). Wraps kubectl + kustomize around k8s/. `visionkb-k8s help` lists the commands.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
K8S="$REPO_DIR/k8s"
NS=visionkb
VERSION="0.1.7"

die() {
  echo "visionkb-k8s: error: $*" >&2
  exit 1
}
log() { echo "visionkb-k8s: $*" >&2; }
# shellcheck source=libexec/visionkb-env.sh
source "$REPO_DIR/libexec/visionkb-env.sh"
shopt -u patsub_replacement 2>/dev/null || true # bash >= 5.2: keep '&' literal in ${x//a/b}

usage() {
  cat <<'EOF'
Usage: visionkb-k8s [--env-file FILE] [--overlay local-bundle|fetch-bundle] COMMAND [ARGS]

Setup
  sync [--check]                 regenerate k8s/base images + scripts and the overlays' VISIONKB_KG_BUNDLE_SHA256
                                 from versions.env (--check: fail if stale)
  render                         print the manifests of the selected overlay (kustomize build)
  create-secrets --from DIR      create/update Secrets from the files `bin/visionkb init` wrote
  apply                          kubectl apply -k the selected overlay

Releases (bundles only; the cluster never reads the HPC filesystem)
  upload-bundle TAR [--no-load]  local-bundle: copy TAR(+.sha256) into the bundles volume, verify, load
                                 (the pinned release must match VISIONKB_KG_BUNDLE_SHA256, checked before upload)
  fetch-bundle ID [--url URL] [--no-load]
                                 fetch-bundle: Job downloads ID.tar(+.sha256) over HTTPS, verifies, load
  load-release ID [--force]      Job: verify + neo4j-admin import into a new store /releases/ID
  switch ID [--no-apply]         serve ID (must be loaded): edit overlay release.env, apply, wait for rollout
  rollback [--no-apply]          switch to VISIONKB_PREVIOUS_RELEASE
  render-template NAME ID        print a rendered Job/Pod template (load-release | fetch-bundle | upload-pod)
  status                         pods, jobs, volumes and the served release

Settings: VISIONKB_K8S_OVERLAY (default local-bundle) selects the delivery mode; VISIONKB_KUBECTL,
VISIONKB_KUSTOMIZE (use a standalone kustomize instead of `kubectl kustomize`), VISIONKB_LOAD_HEAP,
VISIONKB_LOAD_PAGECACHE, VISIONKB_BUNDLE_URL_TEMPLATE (fetch-bundle; {release} is replaced).
EOF
}

load_settings() {
  local env_file="${OPT_ENV_FILE:-${VISIONKB_ENV_FILE:-}}"
  [[ -n "$env_file" ]] && load_env_file "$env_file"
  load_versions_env "$REPO_DIR/versions.env"
  [[ -n "${OPT_OVERLAY:-}" ]] && export VISIONKB_K8S_OVERLAY="$OPT_OVERLAY"
  : "${VISIONKB_K8S_OVERLAY:=local-bundle}"
  : "${VISIONKB_KUBECTL:=kubectl}"
  : "${VISIONKB_LOAD_HEAP:=4g}"
  : "${VISIONKB_LOAD_PAGECACHE:=2g}"
  : "${VISIONKB_K8S_TIMEOUT:=3600}"
  case "$VISIONKB_K8S_OVERLAY" in local-bundle | fetch-bundle) ;; *)
    die "VISIONKB_K8S_OVERLAY must be local-bundle or fetch-bundle (got '$VISIONKB_K8S_OVERLAY')"
    ;;
  esac
  OVERLAY="$K8S/overlays/$VISIONKB_K8S_OVERLAY"
  RELEASE_ENV="$OVERLAY/release.env"
}

kc() { "$VISIONKB_KUBECTL" "$@"; }
need_kubectl() { command -v "$VISIONKB_KUBECTL" >/dev/null 2>&1 || die "kubectl not found (set VISIONKB_KUBECTL)"; }
dns_name() { printf '%s' "${1//./-}"; }

# release.env values (KEY=VALUE, read without executing)
release_get() { sed -n "s/^$1=//p" "$RELEASE_ENV" | tail -n 1; }
release_set_pair() { # release_set_pair CURRENT PREVIOUS: also VISIONKB_KG_BUNDLE_SHA256 of CURRENT (or empty)
  release_write "$RELEASE_ENV" "$1" "$2" "$(pinned_sha_for "$1")"
}
release_write() { # release_write FILE CURRENT PREVIOUS SHA (other lines kept, order of the three keys fixed)
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  {
    grep -v -E '^(VISIONKB_KG_RELEASE|VISIONKB_PREVIOUS_RELEASE|VISIONKB_KG_BUNDLE_SHA256)=' "$1" || true
    printf 'VISIONKB_KG_RELEASE=%s\nVISIONKB_PREVIOUS_RELEASE=%s\nVISIONKB_KG_BUNDLE_SHA256=%s\n' "$2" "$3" "$4"
  } >"$tmp"
  mv "$tmp" "$1"
}

# Bundle pin. versions.env pins the bundle of its VISIONKB_KG_RELEASE with VISIONKB_KG_BUNDLE_SHA256; release.env
# carries the sha of the release it serves (written by sync / switch). Other releases are not pinned.
pinned_sha_for() { # pinned_sha_for ID: the versions.env pin if ID is the pinned release, else empty
  if [[ "$1" == "${VISIONKB_KG_RELEASE:-}" ]]; then printf '%s' "${VISIONKB_KG_BUNDLE_SHA256:-}"; fi
}
bundle_pin_for() { # bundle_pin_for ID: sha the bundle of ID must have (versions.env or release.env), or empty
  local a b=""
  a="$(pinned_sha_for "$1")"
  if [[ "$1" == "$(release_get VISIONKB_KG_RELEASE)" ]]; then b="$(release_get VISIONKB_KG_BUNDLE_SHA256)"; fi
  b="${b,,}"
  if [[ -n "$a" && -n "$b" && "$a" != "$b" ]]; then
    die "$1: VISIONKB_KG_BUNDLE_SHA256 differs between versions.env ($a) and $RELEASE_ENV ($b); run bin/visionkb-k8s sync"
  fi
  printf '%s' "${a:-$b}"
}

# ---------------------------------------------------------------------------------------------
# sync: versions.env -> k8s/base (images block, script copies)
# ---------------------------------------------------------------------------------------------

images_block() {
  local var ref name tag digest
  echo "# BEGIN images (generated by \`bin/visionkb-k8s sync\` from versions.env; do not edit)"
  echo "images:"
  for var in VISIONKB_NEO4J_IMAGE VISIONKB_POSTGRES_IMAGE VISIONKB_API_IMAGE VISIONKB_WEB_IMAGE; do
    ref="$(sed -n "s/^$var=//p" "$REPO_DIR/versions.env" | tail -n 1)"
    [[ -n "$ref" ]] || die "versions.env: $var missing"
    read -r name tag digest <<<"$(image_parts "$ref")"
    echo "  - name: $name"
    if [[ "$digest" != - ]]; then
      echo "    digest: $digest"
    else
      echo "    newTag: \"${tag/#-/latest}\""
    fi
  done
  echo "# END images"
}

render_kustomization() { # stdout: base kustomization.yaml with a fresh images block
  local block
  block="$(images_block)"
  awk -v block="$block" '
    /^# BEGIN images/ { print block; skip = 1; next }
    /^# END images/ { skip = 0; next }
    !skip { print }
  ' "$K8S/base/kustomization.yaml"
}

cmd_sync() {
  local check=0
  [[ "${1:-}" == --check ]] && check=1
  local kust="$K8S/base/kustomization.yaml" stale=0 tmp
  tmp="$(mktemp)"
  render_kustomization >"$tmp"
  if ! cmp -s "$tmp" "$kust"; then
    stale=1
    ((check)) || cp "$tmp" "$kust"
  fi
  rm -f "$tmp"
  local src dst
  for pair in "libexec/neo4j-load-release.sh:k8s/base/scripts/neo4j-load-release.sh" \
    "src/visionkb_deploy/bundle.py:k8s/base/scripts/bundle.py"; do
    src="$REPO_DIR/${pair%%:*}"
    dst="$REPO_DIR/${pair#*:}"
    if ! cmp -s "$src" "$dst"; then
      stale=1
      ((check)) || cp "$src" "$dst"
    fi
  done
  # overlays serving the versions.env release carry its bundle sha (raw versions.env values, like the images)
  local vrel vsha renv cur prev have
  vrel="$(sed -n 's/^VISIONKB_KG_RELEASE=//p' "$REPO_DIR/versions.env" | tail -n 1)"
  vsha="$(sed -n 's/^VISIONKB_KG_BUNDLE_SHA256=//p' "$REPO_DIR/versions.env" | tail -n 1)"
  vsha="${vsha,,}"
  for renv in "$K8S"/overlays/*/release.env; do
    cur="$(sed -n 's/^VISIONKB_KG_RELEASE=//p' "$renv" | tail -n 1)"
    [[ "$cur" == "$vrel" ]] || continue
    prev="$(sed -n 's/^VISIONKB_PREVIOUS_RELEASE=//p' "$renv" | tail -n 1)"
    have="$(sed -n 's/^VISIONKB_KG_BUNDLE_SHA256=//p' "$renv" | tail -n 1)"
    if [[ "$have" != "$vsha" ]] || ! grep -q '^VISIONKB_KG_BUNDLE_SHA256=' "$renv"; then
      stale=1
      ((check)) || release_write "$renv" "$cur" "$prev" "$vsha"
    fi
  done
  if ((check)); then
    ((stale == 0)) || die "k8s/ is out of date with versions.env or libexec/src; run bin/visionkb-k8s sync"
    log "sync --check: k8s/base is up to date"
  else
    log "sync: k8s/base and overlay release.env updated from versions.env"
  fi
}

# ---------------------------------------------------------------------------------------------
# render / apply / secrets
# ---------------------------------------------------------------------------------------------

kustomize_build() {
  if [[ -n "${VISIONKB_KUSTOMIZE:-}" ]]; then
    "$VISIONKB_KUSTOMIZE" build "$1"
  else
    need_kubectl
    kc kustomize "$1"
  fi
}

cmd_render() { kustomize_build "$OVERLAY"; }

cmd_apply() {
  need_kubectl
  cmd_sync --check
  kc apply -f "$K8S/base/namespace.yaml"
  kustomize_build "$OVERLAY" | kc apply -f -
}

cmd_create_secrets() {
  local dir=""
  [[ "${1:-}" == --from ]] && dir="${2:-}"
  [[ -n "$dir" && -d "$dir" ]] || die "usage: visionkb-k8s create-secrets --from DIR (DIR from 'bin/visionkb init')"
  local f
  for f in neo4j_password pg_password pg_dsn api_tokens api_token_read web_secret web_access_codes; do
    [[ -s "$dir/$f" ]] || die "$dir/$f missing (bin/visionkb init adds missing secrets and keeps existing ones)"
  done
  grep -q '@postgres:5432/' "$dir/pg_dsn" ||
    log "WARNING: pg_dsn does not point at postgres:5432 (init with VISIONKB_PG_HOST=postgres VISIONKB_PG_PORT=5432)"
  need_kubectl
  kc apply -f "$K8S/base/namespace.yaml"
  kc -n "$NS" create secret generic visionkb-neo4j --from-file=neo4j_password="$dir/neo4j_password" \
    --dry-run=client -o yaml | kc apply -f -
  kc -n "$NS" create secret generic visionkb-postgres --from-file=pg_password="$dir/pg_password" \
    --dry-run=client -o yaml | kc apply -f -
  kc -n "$NS" create secret generic visionkb-api --from-file=pg_dsn="$dir/pg_dsn" \
    --from-file=api_tokens="$dir/api_tokens" --dry-run=client -o yaml | kc apply -f -
  kc -n "$NS" create secret generic visionkb-web --from-file=api_token_read="$dir/api_token_read" \
    --from-file=web_secret="$dir/web_secret" --from-file=web_access_codes="$dir/web_access_codes" \
    --dry-run=client -o yaml | kc apply -f -
  log "secrets visionkb-neo4j, visionkb-postgres, visionkb-api, visionkb-web applied"
}

# ---------------------------------------------------------------------------------------------
# templates
# ---------------------------------------------------------------------------------------------

template_path() {
  case "$1" in
  load-release) printf '%s' "$K8S/base/jobs/load-release.yaml" ;;
  fetch-bundle) printf '%s' "$K8S/overlays/fetch-bundle/fetch-bundle.yaml" ;;
  upload-pod) printf '%s' "$K8S/overlays/local-bundle/upload-pod.yaml" ;;
  *) die "unknown template '$1' (load-release | fetch-bundle | upload-pod)" ;;
  esac
}

bundle_url() { # bundle_url ID [URL]
  local url="${2:-${VISIONKB_BUNDLE_URL:-}}" tmpl
  if [[ -z "$url" ]]; then
    tmpl="${VISIONKB_BUNDLE_URL_TEMPLATE:-$(sed -n 's/^ *- VISIONKB_BUNDLE_URL_TEMPLATE=//p' "$K8S/overlays/fetch-bundle/kustomization.yaml")}"
    url="${tmpl//\{release\}/$1}"
  fi
  [[ "$url" == https://* || "$url" == http://* ]] || die "bundle URL must be http(s): $url"
  printf '%s' "$url"
}

render_template() { # render_template NAME ID [URL]
  local name="$1" rel="$2" text url pin
  check_release_id "$rel"
  text="$(<"$(template_path "$name")")"
  text="${text//__KG_RELEASE_DNS__/$(dns_name "$rel")}"
  text="${text//__KG_RELEASE__/$rel}"
  text="${text//__NEO4J_IMAGE__/${VISIONKB_NEO4J_IMAGE:?}}"
  text="${text//__TOOLS_IMAGE__/${VISIONKB_TOOLS_IMAGE:?}}"
  text="${text//__LOAD_HEAP__/$VISIONKB_LOAD_HEAP}"
  text="${text//__LOAD_PAGECACHE__/$VISIONKB_LOAD_PAGECACHE}"
  if [[ "$name" == fetch-bundle ]]; then
    url="$(bundle_url "$rel" "${3:-}")"
    pin="$(bundle_pin_for "$rel")"
    text="${text//__BUNDLE_URL__/$url}"
    text="${text//__BUNDLE_SHA256__/$pin}"
  fi
  [[ "$text" != *__[A-Z_]*__* ]] || die "template $name: unreplaced placeholder"
  printf '%s\n' "$text"
}

cmd_render_template() {
  (($# >= 2)) || die "usage: visionkb-k8s render-template NAME ID"
  render_template "$@"
}

wait_job() { # wait_job NAME: poll until succeeded/failed, print the tail of its logs
  local job="$1" deadline=$((SECONDS + VISIONKB_K8S_TIMEOUT)) ok fail
  while true; do
    ok="$(kc -n "$NS" get job "$job" -o jsonpath='{.status.succeeded}' 2>/dev/null || true)"
    fail="$(kc -n "$NS" get job "$job" -o jsonpath='{.status.failed}' 2>/dev/null || true)"
    if [[ "${ok:-0}" -ge 1 ]]; then
      kc -n "$NS" logs "job/$job" --all-containers --tail=20 >&2 || true
      log "job $job succeeded"
      return 0
    fi
    if [[ "${fail:-0}" -ge 1 ]] && [[ "$(kc -n "$NS" get job "$job" -o jsonpath='{.status.active}' 2>/dev/null || true)" == "" ]]; then
      kc -n "$NS" logs "job/$job" --all-containers --tail=50 >&2 || true
      die "job $job failed"
    fi
    ((SECONDS < deadline)) || die "job $job not finished after ${VISIONKB_K8S_TIMEOUT}s"
    sleep 5
  done
}

# ---------------------------------------------------------------------------------------------
# releases
# ---------------------------------------------------------------------------------------------

cmd_load_release() {
  local rel="" force=0
  while (($#)); do
    case "$1" in
    --force) force=1 ;;
    -*) die "load-release: unknown option $1" ;;
    *) rel="$1" ;;
    esac
    shift
  done
  [[ -n "$rel" ]] || die "usage: visionkb-k8s load-release ID"
  check_release_id "$rel"
  need_kubectl
  local job
  job="visionkb-load-$(dns_name "$rel")"
  if kc -n "$NS" get job "$job" >/dev/null 2>&1; then
    ((force)) || die "job $job exists (a store for $rel may already exist); --force deletes the job, not the store"
    kc -n "$NS" delete job "$job" --wait=true
  fi
  render_template load-release "$rel" | kc apply -f -
  wait_job "$job"
  log "loaded $rel; serve it with: visionkb-k8s switch $rel"
}

cmd_upload_bundle() {
  local tar="" load=1
  while (($#)); do
    case "$1" in
    --no-load) load=0 ;;
    -*) die "upload-bundle: unknown option $1" ;;
    *) tar="$1" ;;
    esac
    shift
  done
  [[ -f "$tar" && -f "$tar.sha256" ]] || die "usage: visionkb-k8s upload-bundle ID.tar (with ID.tar.sha256 next to it)"
  [[ "$VISIONKB_K8S_OVERLAY" == local-bundle ]] || log "note: overlay is $VISIONKB_K8S_OVERLAY; uploading anyway"
  local rel want got
  rel="$(basename "$tar" .tar)"
  check_release_id "$rel"
  want="$(awk 'NR==1{print tolower($1)}' "$tar.sha256")"
  got="$(sha256sum "$tar" | cut -d' ' -f1)"
  [[ "$want" == "$got" ]] || die "$tar: sha256 $got != $tar.sha256 ($want)"
  local pin
  pin="$(bundle_pin_for "$rel")"
  if [[ -n "$pin" ]]; then
    [[ "$got" == "$pin" ]] || die "$rel: bundle sha256 $got != pinned VISIONKB_KG_BUNDLE_SHA256 $pin; refusing it"
    log "upload-bundle: $tar sha256 ok (= pinned VISIONKB_KG_BUNDLE_SHA256)"
  else
    log "upload-bundle: $tar sha256 ok"
  fi
  need_kubectl
  local pod=visionkb-bundle-upload
  kc -n "$NS" delete pod "$pod" --ignore-not-found --wait=true >/dev/null
  render_template upload-pod "$rel" | kc apply -f -
  trap 'kc -n "$NS" delete pod "$pod" --ignore-not-found --wait=false >/dev/null 2>&1 || true' EXIT
  kc -n "$NS" wait --for=condition=Ready "pod/$pod" --timeout=300s
  kc -n "$NS" exec "$pod" -- mkdir -p /bundles/incoming /bundles/releases
  kc -n "$NS" cp "$tar" "$NS/$pod:/bundles/incoming/$rel.tar"
  kc -n "$NS" cp "$tar.sha256" "$NS/$pod:/bundles/incoming/$rel.tar.sha256"
  kc -n "$NS" exec "$pod" -- python3 /opt/visionkb/bundle.py unpack "/bundles/incoming/$rel.tar" \
    --dest /bundles/releases --release "$rel" "--pin=$rel=$pin"
  kc -n "$NS" delete pod "$pod" --wait=false >/dev/null
  trap - EXIT
  ((load)) && cmd_load_release "$rel"
  return 0
}

cmd_fetch_bundle() {
  local rel="" url="" load=1
  while (($#)); do
    case "$1" in
    --url)
      url="${2:?--url needs a value}"
      shift
      ;;
    --no-load) load=0 ;;
    -*) die "fetch-bundle: unknown option $1" ;;
    *) rel="$1" ;;
    esac
    shift
  done
  [[ -n "$rel" ]] || die "usage: visionkb-k8s fetch-bundle ID [--url URL]"
  check_release_id "$rel"
  need_kubectl
  local job
  job="visionkb-fetch-$(dns_name "$rel")"
  kc -n "$NS" delete job "$job" --ignore-not-found --wait=true >/dev/null
  local manifest
  manifest="$(render_template fetch-bundle "$rel" "$url")"
  [[ "$manifest" == *"PIN_SHA256"* ]] || die "fetch-bundle: rendering failed"
  if grep -q 'value: "[0-9a-f]\{64\}"' <<<"$manifest"; then log "fetch-bundle: $rel is pinned; the Job checks VISIONKB_KG_BUNDLE_SHA256"; fi
  printf '%s\n' "$manifest" | kc apply -f -
  wait_job "$job"
  ((load)) && cmd_load_release "$rel"
  return 0
}

release_is_loaded() { # evidence: LOADED.json visible from the neo4j pod, or a succeeded load Job
  local rel="$1" ok
  if kc -n "$NS" exec statefulset/neo4j -c neo4j -- test -s "/releases/$rel/LOADED.json" 2>/dev/null; then
    return 0
  fi
  ok="$(kc -n "$NS" get job "visionkb-load-$(dns_name "$rel")" -o jsonpath='{.status.succeeded}' 2>/dev/null || true)"
  [[ "${ok:-0}" -ge 1 ]]
}

cmd_switch() {
  local rel="" apply=1
  while (($#)); do
    case "$1" in
    --no-apply) apply=0 ;;
    -*) die "switch: unknown option $1" ;;
    *) rel="$1" ;;
    esac
    shift
  done
  [[ -n "$rel" ]] || die "usage: visionkb-k8s switch ID"
  check_release_id "$rel"
  local cur
  cur="$(release_get VISIONKB_KG_RELEASE)"
  [[ "$rel" != "$cur" ]] || die "$rel is already the served release in $RELEASE_ENV"
  if ((apply)); then
    need_kubectl
    release_is_loaded "$rel" || die "$rel is not loaded in the cluster; run: visionkb-k8s load-release $rel"
  fi
  release_set_pair "$rel" "$cur"
  log "switch: $RELEASE_ENV now serves $rel (previous $cur)"
  if ((apply)); then
    cmd_apply
    kc -n "$NS" rollout status statefulset/neo4j --timeout=900s
    kc -n "$NS" rollout status deployment/visionkb-api --timeout=600s
  fi
}

cmd_rollback() {
  local prev
  prev="$(release_get VISIONKB_PREVIOUS_RELEASE)"
  [[ -n "$prev" ]] || die "no VISIONKB_PREVIOUS_RELEASE in $RELEASE_ENV"
  cmd_switch "$prev" "$@"
}

cmd_status() {
  need_kubectl
  echo "overlay: $VISIONKB_K8S_OVERLAY"
  echo "served (release.env): $(release_get VISIONKB_KG_RELEASE)  previous: $(release_get VISIONKB_PREVIOUS_RELEASE)"
  kc -n "$NS" get pods,jobs,pvc -o wide || true
  kc -n "$NS" get ingress || true
}

main() {
  OPT_ENV_FILE=""
  OPT_OVERLAY=""
  while (($#)); do
    case "$1" in
    --env-file)
      OPT_ENV_FILE="${2:?--env-file needs a file}"
      shift
      ;;
    --overlay)
      OPT_OVERLAY="${2:?--overlay needs a value}"
      shift
      ;;
    -h | --help | help)
      usage
      return 0
      ;;
    --version | version)
      echo "visionkb-deploy $VERSION (visionkb-k8s)"
      return 0
      ;;
    -*) die "unknown option $1 (see 'visionkb-k8s help')" ;;
    *) break ;;
    esac
    shift
  done
  (($#)) || {
    usage >&2
    return 2
  }
  local cmd="$1"
  shift
  load_settings
  case "$cmd" in
  sync) cmd_sync "$@" ;;
  render) cmd_render "$@" ;;
  apply) cmd_apply "$@" ;;
  create-secrets) cmd_create_secrets "$@" ;;
  upload-bundle) cmd_upload_bundle "$@" ;;
  fetch-bundle) cmd_fetch_bundle "$@" ;;
  load-release) cmd_load_release "$@" ;;
  switch) cmd_switch "$@" ;;
  rollback) cmd_rollback "$@" ;;
  render-template) cmd_render_template "$@" ;;
  status) cmd_status "$@" ;;
  *) die "unknown command '$cmd' (see 'visionkb-k8s help')" ;;
  esac
}

main "$@"
